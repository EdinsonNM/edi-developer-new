# ─────────────────────────────────────────────────────────────
# Variables de entorno · edi-developer.dev
# Copia este archivo a `.env` y completa los valores:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── IA: consola "Pregúntale a la IA" del landing (/api/chat) ──
# OBLIGATORIA para que el chat responda. Sin ella el endpoint
# devuelve 500: "OPENAI_API_KEY no está configurada en el servidor".
# Obtén tu key en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo de OpenAI a usar (opcional). Por defecto: gpt-4o-mini.
# Ej.: gpt-4o-mini · gpt-4o · gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini

# ── Analítica (opcional) ──
# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Si se deja vacío, GA simplemente no se carga.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Desarrollo (opcional) ──
# Puerto del dev server / start. Por defecto el proyecto usa 8080.
PORT=8080
